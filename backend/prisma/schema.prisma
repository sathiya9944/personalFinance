generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  type      String
  category  String
  createdAt DateTime @default(now())
}

model Budget {
  id       Int    @id @default(autoincrement())
  category String
  limit    Float
  month    Int
  year     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, month, year])
}
